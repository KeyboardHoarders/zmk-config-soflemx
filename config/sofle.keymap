#include "keys_sv.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Encoders

&sensors { triggers-per-rotation = <30>; };

&left_encoder { steps = <60>; };

&right_encoder { steps = <60>; };

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    combos {
        compatible = "zmk,combos";

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <32 31>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <25 41>;
        };
    };

    behaviors {
        caps: caps {
            compatible = "zmk,behavior-caps-word";
            label = "CAPS";
            #binding-cells = <0>;
            continue-list = <SE_POUND SE_MINUS BACKSPACE SE_UNDER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   +   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   Å   |
            // | SHIFT |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   Ö   |   Ä   |
            // | CTRL  |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  | PLAY  |  N   |  M    |  ,    |  .   |   -   | SHIFT |
            //               | CTRL| ALT  | CMD  | LOWER|  SPACE |  | ENTER | RAISE| CMD   | ALT   | BSPC |

            bindings = <
&gresc            &kp SE_N1  &kp SE_N2  &kp SE_N3  &kp SE_N4  &kp SE_N5                                     &kp SE_N6  &kp SE_N7  &kp SE_N8     &kp SE_N9    &kp SE_N0     &kp SE_PLUS
&kp TAB           &kp SE_Q   &kp SE_W   &kp SE_E   &kp SE_R   &kp SE_T                                      &kp SE_Y   &kp SE_U   &kp SE_I      &kp SE_O     &kp SE_P      &kp SE_ARING
&kp LEFT_SHIFT    &kp SE_A   &kp SE_S   &kp SE_D   &kp SE_F   &kp SE_G                                      &kp SE_H   &kp SE_J   &kp SE_K      &kp SE_L     &kp SE_ODIAE  &kp SE_ADIAE
&kp LEFT_CONTROL  &kp SE_Z   &kp SE_X   &kp SE_C   &kp SE_V   &kp SE_B   &kp C_MUTE    &kp C_PLAY_PAUSE     &kp SE_N   &kp SE_M   &kp SE_COMMA  &kp SE_DOT   &kp SE_MINUS  &kp RSHFT
                             &kp LCTRL  &kp LALT   &kp LGUI   &mo LOWER  &kp SPACE     &kp ENTER            &mo RAISE  &kp RGUI   &kp RALT      &kp BSPC
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp UP DOWN>;
        };

        lower_layer {
            display-name = "Symbols";

            // ------------------------------------------------------------------------------------------------------------
            // |  §    |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |  `    |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |  F12  |
            // |  ~    |  =  |  -  |  +   |  /   |  \   |                   |  |   |  {    |  }    |  [   |   ]   |   '   |
            // |       |  <  |  >  |  ;   |  :   |  "   |        |  |       |  _   |  ?    |  <    |  >   |   /   |  DEL  |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp SE_SECT   &kp F1        &kp F2        &kp F3        &kp F4        &kp F5                          &kp F6         &kp F7        &kp F8        &kp F9        &kp F10       &kp F11
&kp SE_GRAVE  &kp SE_EXCL   &kp SE_AT     &kp SE_HASH   &kp SE_DLLR   &kp SE_PRCNT                    &kp SE_CARET   &kp SE_AMPS   &kp SE_ASTRK  &kp SE_LPAR   &kp SE_RPAR   &kp F12
&kp SE_TILDE  &kp SE_EQUAL  &kp SE_MINUS  &kp SE_PLUS   &kp SE_FSLH   &kp SE_BSLH                     &kp SE_PIPE    &kp SE_LBRC   &kp SE_RBRC   &kp SE_LBKT   &kp SE_RBKT   &kp SE_SQT
&trans        &kp SE_LT     &kp SE_GT     &kp SE_SEMI   &kp SE_COLON  &kp SE_DQT    &trans    &trans  &kp SE_UNDER   &kp SE_QMARK  &kp SE_LT     &kp SE_GT     &kp SE_FSLH   &kp DELETE
                            &trans        &trans        &trans        &trans        &trans    &trans  &trans         &trans        &trans        &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        raise_layer {
            display-name = "Nav";

            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |      |       |      |       |       |
            // |       | INS |PSCR | MENU |      |      |                   | PGUP |      |   ^   |      |       |       |
            // |       | ALT |CTRL | SHIFT|      | CAPS |                   | PGDN |  <-  |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO| CUT | COPY | PASTE|      |        |  |       |      |      |       |      |       |       |
            //               |     |      |      |      |        |  |       |      |      |       |      |

            bindings = <
&trans  &trans      &trans     &trans       &trans       &trans                      &trans     &trans    &trans    &trans     &trans   &trans
&trans  &kp INS     &kp PSCRN  &kp K_CMENU  &trans       &trans                      &kp PG_UP  &trans    &kp UP    &trans     &trans   &trans
&trans  &kp LALT    &kp LCTRL  &kp LSHFT    &trans       &kp CLCK                    &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL  &kp BSPC
&trans  &kp K_UNDO  &kp K_CUT  &kp K_COPY   &kp K_PASTE  &trans    &trans    &trans  &trans     &trans    &trans    &trans     &trans   &trans
                    &trans     &trans       &trans       &trans    &trans    &trans  &trans     &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            display-name = "System";

            bindings = <
&bt BT_CLR_ALL     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &none  &none  &none  &none  &none  &none
&ext_power EP_TOG  &none         &none         &none         &none         &studio_unlock                &none  &none  &none  &none  &none  &none
&none              &none         &none         &none         &none         &none                         &none  &none  &none  &none  &none  &none
&none              &none         &none         &none         &none         &caps_word    &none    &none  &none  &none  &none  &none  &none  &none
                                 &none         &none         &none         &none         &none    &none  &none  &none  &none  &none
            >;
        };
    };
};
